 "subs": [
  {
   "id": "L1",
   "t0": 0.6,
   "t1": 5.65,
   "text": "Konrad Curze could see the future. And it was always dark."
  },
  {
   "id": "L2",
   "t0": 6,
   "t1": 11.126666666666667,
   "text": "He grew up alone on Nostramo, a world that never saw the sun."
  },
  {
   "id": "L3",
   "t0": 11.6,
   "t1": 16.75,
   "text": "He hunted its criminals in the night, until the whole world feared him."
  },
  {
   "id": "L4",
   "t0": 17.1,
   "t1": 21.349999999999998,
   "text": "He led the Night Lords, and ruled through terror."
  },
  {
   "id": "L5",
   "t0": 21.7,
   "t1": 26.25,
   "text": "When his homeworld fell back into crime, he destroyed it."
  },
  {
   "id": "L6",
   "t0": 26.6,
   "t1": 29.65,
   "text": "He joined Horus. Then he saw his own death."
  },
  {
   "id": "L7",
   "t0": 30,
   "t1": 33.449999999999996,
   "text": "An assassin, sent by the Emperor."
  },
  {
   "id": "L8",
   "t0": 33.8,
   "t1": 38.949999999999996,
   "text": "Curze could have fled. Instead, he waited for her on his throne."
  },
  {
   "id": "L9",
   "t0": 39.3,
   "t1": 44.49333333333333,
   "text": "His last words: death is nothing, compared to vindication."
  }
 ]
