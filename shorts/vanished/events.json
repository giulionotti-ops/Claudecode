 "subs": [
  {
   "id": "L1",
   "t0": 0.6,
   "t1": 6.46,
   "text": "In the year nine six three, an entire Chapter of Space Marines vanished."
  },
  {
   "id": "L2",
   "t0": 7,
   "t1": 13.65,
   "text": "The Fire Hawks boarded their great fortress-ship, the Raptorus Rex, and entered the warp."
  },
  {
   "id": "L3",
   "t0": 14,
   "t1": 16.993333333333332,
   "text": "They never came out."
  },
  {
   "id": "L4",
   "t0": 17.4,
   "t1": 22.259999999999998,
   "text": "No wreck was found. No message. Not a single survivor."
  },
  {
   "id": "L5",
   "t0": 23.2,
   "t1": 27.45,
   "text": "Then, on battlefields across the galaxy, a new legend began."
  },
  {
   "id": "L6",
   "t0": 27.8,
   "t1": 34.193333333333335,
   "text": "When all hope is lost, warriors in black armour appear, wreathed in ghostly fire."
  },
  {
   "id": "L7",
   "t0": 34.8,
   "t1": 40.79333333333333,
   "text": "The Legion of the Damned. They save the doomed, then vanish without a word."
  },
  {
   "id": "L8",
   "t0": 41.2,
   "t1": 45.65,
   "text": "Some say they are the lost Fire Hawks, burning forever in the warp."
  },
  {
   "id": "L9",
   "t0": 46,
   "t1": 50.66,
   "text": "No one knows for sure. And the Legion never speaks."
  }
 ]
