 "subs": [
  {
   "id": "L1",
   "t0": 0.6,
   "t1": 7.326666666666666,
   "text": "Luther found the Lion as a wild child in the forests of Caliban, and raised him like a son."
  },
  {
   "id": "L2",
   "t0": 7.8,
   "t1": 12.25,
   "text": "They became brothers. Then the Emperor came for the Lion."
  },
  {
   "id": "L3",
   "t0": 12.6,
   "t1": 17.65,
   "text": "The Lion led the Dark Angels to the stars. Luther was left behind."
  },
  {
   "id": "L4",
   "t0": 18,
   "t1": 23.25,
   "text": "Year after year in the Lion's shadow, his love turned to jealousy."
  },
  {
   "id": "L5",
   "t0": 23.6,
   "t1": 27.45,
   "text": "The dark gods whispered, and Luther listened."
  },
  {
   "id": "L6",
   "t0": 27.8,
   "t1": 32.55,
   "text": "When the Lion came home, Luther turned the guns of Caliban on his brother."
  },
  {
   "id": "L7",
   "t0": 32.9,
   "t1": 37.85,
   "text": "The two friends fought, and Caliban broke apart around them."
  },
  {
   "id": "L8",
   "t0": 38.2,
   "t1": 44.65,
   "text": "The Lion vanished. Luther was taken alive, and locked away for ten thousand years."
  },
  {
   "id": "L9",
   "t0": 45,
   "t1": 50.46,
   "text": "To this day, the Dark Angels hunt the Fallen, to bury their shame."
  }
 ]
