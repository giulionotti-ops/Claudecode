 "subs": [
  {
   "id": "L1",
   "t0": 0.6,
   "t1": 6.25,
   "text": "Ferrus Manus and Fulgrim were the closest of all the Emperor's sons."
  },
  {
   "id": "L2",
   "t0": 6.6,
   "t1": 10.85,
   "text": "To honour their bond, they forged weapons for each other."
  },
  {
   "id": "L3",
   "t0": 11.2,
   "t1": 18.854999999999997,
   "text": "Ferrus made Fireblade, a sword that burned forever. Fulgrim made Forgebreaker, a mighty hammer."
  },
  {
   "id": "L4",
   "t0": 19.9,
   "t1": 24.65,
   "text": "Then Fulgrim fell to the dark gods, and begged his brother to join Horus."
  },
  {
   "id": "L5",
   "t0": 25,
   "t1": 27.45,
   "text": "Ferrus refused."
  },
  {
   "id": "L6",
   "t0": 27.8,
   "t1": 32.05,
   "text": "On Isstvan Five, they met again, each holding the other's gift."
  },
  {
   "id": "L7",
   "t0": 32.4,
   "t1": 36.75,
   "text": "Ferrus was winning. Then Fulgrim drew a daemon blade."
  },
  {
   "id": "L8",
   "t0": 37.1,
   "t1": 41.35,
   "text": "With one stroke, he cut off his best friend's head."
  },
  {
   "id": "L9",
   "t0": 41.7,
   "t1": 45.05,
   "text": "The Iron Hands never found their father's body."
  },
  {
   "id": "L10",
   "t0": 45.4,
   "t1": 49.99333333333333,
   "text": "And Fulgrim knew, too late, how far he had fallen."
  }
 ]
