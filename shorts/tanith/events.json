 "subs": [
  {
   "id": "L1",
   "t0": 0.6,
   "t1": 5.680000000000001,
   "text": "Gaunt's Ghosts lost their entire world... on the day they were founded."
  },
  {
   "id": "L2",
   "t0": 6.03,
   "t1": 11.35,
   "text": "Tanith was a world of moving forests. Its people never got lost."
  },
  {
   "id": "L3",
   "t0": 11.7,
   "t1": 18.349999999999998,
   "text": "Six thousand of them joined the Imperial Guard, under Colonel-Commissar Ibram Gaunt."
  },
  {
   "id": "L4",
   "t0": 18.7,
   "t1": 23.619999999999997,
   "text": "Then a Chaos fleet broke through, straight towards Tanith."
  },
  {
   "id": "L5",
   "t0": 23.97,
   "t1": 29.619999999999997,
   "text": "Gaunt had one choice: die defending their home, or save the regiment."
  },
  {
   "id": "L6",
   "t0": 29.97,
   "t1": 34.519999999999996,
   "text": "He ordered them to leave. From orbit, they watched Tanith burn."
  },
  {
   "id": "L7",
   "t0": 34.87,
   "t1": 39.85,
   "text": "Major Rawne swore that one day, he would kill Gaunt for it."
  },
  {
   "id": "L8",
   "t0": 40.2,
   "t1": 45.75,
   "text": "All they had left was a silver knife, and a cloak the colour of their forests."
  },
  {
   "id": "L9",
   "t0": 46.1,
   "t1": 51.82666666666667,
   "text": "They call themselves the First and Only. There will never be a second."
  }
 ]
