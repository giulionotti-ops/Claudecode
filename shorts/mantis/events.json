 "subs": [
  {
   "id": "L1",
   "t0": 0.6,
   "t1": 7.65,
   "text": "For a thousand years, the Mantis Warriors guarded a cluster of worlds at the edge of the Maelstrom, alone."
  },
  {
   "id": "L2",
   "t0": 8,
   "t1": 14.05,
   "text": "Then Lufgt Huron, the Tyrant of Badab, called on his brothers to defend their freedom from Terra."
  },
  {
   "id": "L3",
   "t0": 14.4,
   "t1": 16.849999999999998,
   "text": "The Mantis Warriors answered."
  },
  {
   "id": "L4",
   "t0": 17.2,
   "t1": 21.849999999999998,
   "text": "They never knew Huron had already given his soul to Chaos."
  },
  {
   "id": "L5",
   "t0": 22.2,
   "t1": 28.049999999999997,
   "text": "When the war was lost, they begged the Emperor's forgiveness, and it was granted."
  },
  {
   "id": "L6",
   "t0": 28.4,
   "t1": 33.75,
   "text": "But their Chapter Master was stripped of his armour, and locked away for life."
  },
  {
   "id": "L7",
   "t0": 34.1,
   "t1": 40.449999999999996,
   "text": "Their home was given away, and they were sent on a hundred-year crusade, forbidden to recruit."
  },
  {
   "id": "L8",
   "t0": 40.8,
   "t1": 43.25,
   "text": "Year after year, their numbers dwindled."
  },
  {
   "id": "L9",
   "t0": 43.6,
   "t1": 48.52666666666667,
   "text": "They were forgiven. But many still call them traitors."
  }
 ]
