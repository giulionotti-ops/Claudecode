 "subs": [
  {
   "id": "L1",
   "t0": 0.6,
   "t1": 5.65,
   "text": "Magnus the Red tried to save his father. It destroyed everything he loved."
  },
  {
   "id": "L2",
   "t0": 6,
   "t1": 10.85,
   "text": "The sorcerer Primarch foresaw that Horus would betray the Emperor."
  },
  {
   "id": "L3",
   "t0": 11.2,
   "t1": 16.45,
   "text": "So he used forbidden sorcery to send the warning straight to Terra."
  },
  {
   "id": "L4",
   "t0": 16.8,
   "t1": 21.849999999999998,
   "text": "His spell shattered the wards guarding the Emperor's greatest secret."
  },
  {
   "id": "L5",
   "t0": 22.2,
   "t1": 28.95,
   "text": "The Emperor sent the Space Wolves to bring him in. Horus twisted the order into a death sentence."
  },
  {
   "id": "L6",
   "t0": 29.3,
   "t1": 33.65,
   "text": "The Wolves burned Prospero, his city of light, to the ground."
  },
  {
   "id": "L7",
   "t0": 34,
   "t1": 38.32666666666667,
   "text": "Magnus faced Leman Russ, and Russ broke him."
  },
  {
   "id": "L8",
   "t0": 38.8,
   "t1": 44.413999999999994,
   "text": "As his world died, only one power answered his cry: Tzeentch."
  },
  {
   "id": "L9",
   "t0": 44.8,
   "t1": 49.39333333333333,
   "text": "He warned his father of a traitor, and became one."
  }
