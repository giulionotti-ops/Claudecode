 "subs": [
  {
   "id": "L1",
   "t0": 0.6,
   "t1": 5.050000000000001,
   "text": "The Lamenters may be the unluckiest Chapter in the Imperium."
  },
  {
   "id": "L2",
   "t0": 5.4,
   "t1": 12.85,
   "text": "Sons of the Blood Angels, they carry their father's curse, and misfortune follows them everywhere."
  },
  {
   "id": "L3",
   "t0": 13.2,
   "t1": 20.25,
   "text": "When the Tyrant of Badab rose against the Imperium, the Lamenters believed his cause was just."
  },
  {
   "id": "L4",
   "t0": 20.6,
   "t1": 24.45,
   "text": "They fought their loyal brothers, and they lost."
  },
  {
   "id": "L5",
   "t0": 24.8,
   "t1": 31.45,
   "text": "They were spared, but stripped of their relics, and sent on a hundred-year penitent crusade."
  },
  {
   "id": "L6",
   "t0": 31.8,
   "t1": 33.15,
   "text": "Then the Tyranids came."
  },
  {
   "id": "L7",
   "t0": 33.5,
   "t1": 39.96,
   "text": "Hive Fleet Kraken devoured world after world, and the Lamenters stood in its path."
  },
  {
   "id": "L8",
   "t0": 40.6,
   "t1": 43.65,
   "text": "When it was over, only a few hundred remained."
  },
  {
   "id": "L9",
   "t0": 44,
   "t1": 46.05,
   "text": "Still, they fight on."
  },
  {
   "id": "L10",
   "t0": 46.4,
   "t1": 51.66,
   "text": "Their very name means mourning, and they have never stopped."
  }
 ]
